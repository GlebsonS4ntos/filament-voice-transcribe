{
    "name": "glebsons4ntos/filament-voice-transcribe",
    "description": "This is my package filament-voice-transcribe",
    "keywords": [
        "GlebsonS4ntos",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "filament-voice-transcribe"
    ],
    "homepage": "https://github.com/glebsons4ntos/filament-voice-transcribe",
    "support": {
        "issues": "https://github.com/glebsons4ntos/filament-voice-transcribe/issues",
        "source": "https://github.com/glebsons4ntos/filament-voice-transcribe"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Glebson Santos",
            "email": "glebsonsantos@outlook.pt",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/forms": "^5.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "autoload": {
        "psr-4": {
            "GlebsonS4ntos\\FilamentVoiceTranscribe\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "GlebsonS4ntos\\FilamentVoiceTranscribe\\FilamentVoiceTranscribeServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
